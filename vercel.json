{
  "version": 2,
  "builds": [
    {
      "src": "api/bot.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/bot",
      "dest": "api/bot.js"
    },
    {
      "src": "/api/withdraw/ton",
      "dest": "api/bot.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
